# === Providers ===
# Format: LLM_<NAME>_<FIELD>=value
# Name becomes provider ID (lowercase). Fields: TYPE, ENABLED, URL, KEY, MODEL, TEMPERATURE, MAX_TOKENS, ROLE

# Local llama-server
LLM_LOCAL_ENABLED=true
LLM_LOCAL_TYPE=llama-server
LLM_LOCAL_URL=http://127.0.0.1:8080
LLM_LOCAL_MODEL=gemma-4-12B
LLM_LOCAL_TEMPERATURE=0.7
LLM_LOCAL_MAX_TOKENS=1024

# Deepseek
LLM_DEEPSEEK_ENABLED=false
LLM_DEEPSEEK_TYPE=openai-compatible
LLM_DEEPSEEK_URL=https://api.deepseek.com/v1
LLM_DEEPSEEK_KEY=
LLM_DEEPSEEK_MODEL=deepseek-chat
LLM_DEEPSEEK_TEMPERATURE=0.3
LLM_DEEPSEEK_MAX_TOKENS=4096

# OpenAI
LLM_OPENAI_ENABLED=false
LLM_OPENAI_TYPE=openai-compatible
LLM_OPENAI_URL=https://api.openai.com/v1
LLM_OPENAI_KEY=
LLM_OPENAI_MODEL=gpt-4o
LLM_OPENAI_TEMPERATURE=0.5

# Qwen
LLM_QWEN_ENABLED=false
LLM_QWEN_TYPE=openai-compatible
LLM_QWEN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_QWEN_KEY=
LLM_QWEN_MODEL=qwen-plus
LLM_QWEN_TEMPERATURE=0.7

# Anthropic (Claude)
LLM_ANTHROPIC_ENABLED=false
LLM_ANTHROPIC_TYPE=anthropic
LLM_ANTHROPIC_KEY=
LLM_ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_ANTHROPIC_TEMPERATURE=0.7

# === Router ===
ROUTE_STRATEGY=hybrid
ROUTE_FALLBACK=local,deepseek,openai
ROUTE_CLASSIFICATION_PROVIDER=local
ROUTE_TOOL_CALL_PROVIDER=local
ROUTE_COMPLEXITY_THRESHOLD=0.7

# === Legacy (used when no LLM_<NAME>_* providers defined) ===
LLM_BASE_URL=http://127.0.0.1:8080
LLM_API_KEY=no-key
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=-1

# === ERP ===
ERP_BASE_URL=http://localhost:8000
ERP_SERVICE_TOKEN=

# === Sandbox ===
SANDBOX_TIMEOUT=10
SANDBOX_DIR=sandbox

# === System ===
LOG_LEVEL=INFO
CONVERSATION_MAX_MESSAGES=20
RAG_TOP_K=5
CODE_SEARCH_BACKEND_PATH=
SELF_CRITIQUE_ENABLED=true
